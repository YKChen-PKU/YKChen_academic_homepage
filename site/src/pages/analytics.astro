---
import Base from '../layouts/Base.astro';
import { bundle, refreshedLabel } from '../lib/data';
import CoauthorNetwork from '../components/analytics/CoauthorNetwork.astro';
import PapersPerYear from '../components/analytics/PapersPerYear.astro';
import CitationsCumulative from '../components/analytics/CitationsCumulative.astro';
import HIndexCurve from '../components/analytics/HIndexCurve.astro';
import AuthorPosition from '../components/analytics/AuthorPosition.astro';
import TopCited from '../components/analytics/TopCited.astro';
import JournalSplit from '../components/analytics/JournalSplit.astro';
---
<Base title="Analytics — Yan-Ke Chen">
  <section class="pt-10 grid grid-cols-[90px_1fr] gap-6">
    <div class="font-mono text-[10px] tracking-[0.14em] uppercase text-ink-3 pt-1">
      <span class="block text-[11px] text-mark mb-1">§</span>ANALYTICS
    </div>
    <div>
      <h1 class="text-[36px] font-semibold tracking-tightest text-ink">Seven views of the work</h1>
      <p class="text-[14px] text-ink-2 mt-2 max-w-[68ch]">
        Data sourced from INSPIRE-HEP author
        <a class="text-accent hover:text-ink" href="https://inspirehep.net/authors/2182746">2182746</a>.
        <span class="font-mono text-ink-3"> Refreshed {refreshedLabel}.</span>
        <span class="font-mono text-ink-3"> Per-year citation values use the
          {bundle.metrics.citations_per_year_method} method (attributed to publication year).</span>
      </p>
    </div>
  </section>

  <div class="mt-10 space-y-6">
    <!-- Row 1: Papers per year | Journal split -->
    <div class="grid md:grid-cols-2 gap-6">
      <PapersPerYear />
      <JournalSplit />
    </div>

    <!-- Row 2: Citations | h-index trajectory -->
    <div class="grid md:grid-cols-2 gap-6">
      <CitationsCumulative />
      <HIndexCurve />
    </div>

    <!-- Row 3: Co-author network (wider) | Author position (narrower, donut centered) -->
    <div class="grid md:grid-cols-[1.55fr_1fr] gap-6">
      <CoauthorNetwork />
      <AuthorPosition />
    </div>

    <!-- Row 4: Most-cited (full width) -->
    <TopCited />
  </div>
</Base>
