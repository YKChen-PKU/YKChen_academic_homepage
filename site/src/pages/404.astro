---
import Base from '../layouts/Base.astro';
import T from '../components/T.astro';
---
<Base title="Page not found — Yan-Ke Chen">
  <header class="page-header">
    <div><p class="eyebrow"><T en="404 · Outside the bound state" zh="404 · 页面不存在" /></p><h1 class="page-title"><T en="This page is not here." zh="这里没有页面。" /></h1><p class="page-intro"><T en="The address may have changed, or the page may no longer exist." zh="地址可能已经变更，或该页面已不存在。" /></p><a class="button button--dark" style="margin-top:30px" href="/"><T en="Return to the homepage" zh="返回首页" /> <span aria-hidden="true">→</span></a></div>
  </header>
</Base>
