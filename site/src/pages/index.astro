---
import Base from '../layouts/Base.astro';
import { bundle } from '../lib/data';
import PaperRow from '../components/PaperRow.astro';
import ThemeCard from '../components/ThemeCard.astro';

// 5 most recent papers (any author position)
const recent = [...bundle.papers].sort((a, b) => b.year - a.year).slice(0, 5);

const totals = {
  papers: bundle.papers.length,
  citations: bundle.papers.reduce((s, p) => s + p.citation_count, 0),
  hIndex: Math.max(...Object.values(bundle.metrics.h_index_curve), 0),
  coauthors: bundle.metrics.coauthor_graph.nodes.length,
};
---
<Base title="Yan-Ke Chen — academic homepage">
  <!-- § I · CURRENTLY -->
  <section class="pt-8 md:pt-10 md:grid md:grid-cols-[90px_1fr] md:gap-6">
    <div class="font-mono text-[10px] tracking-[0.14em] uppercase text-ink-3 md:pt-1 mb-3 md:mb-0">
      <span class="text-mark mr-2 md:block md:mb-1 md:mr-0">§ I</span>CURRENTLY
    </div>
    <div>
      <div class="grid grid-cols-1 md:grid-cols-[1fr_0.42fr] gap-6 md:gap-10 items-start">
        <div>
          <h1 class="text-[clamp(34px,8vw,60px)] font-semibold tracking-tightest leading-[1.02] text-ink mb-3.5">
            Yan-Ke Chen
          </h1>
          <p class="text-[15px] md:text-[17px] leading-relaxed text-ink-2 md:max-w-[48ch]">
            <span class="inline-block w-1.5 h-1.5 bg-mark rounded-full mr-1 align-middle pulse-dot"></span>
            Postdoctoral researcher at the
            <em class="not-italic font-medium text-mark">Center for High Energy Physics, Peking University</em>.
            I study hadron spectroscopy, exotic states, low-energy hadron interactions,
            and electromagnetic properties of hadrons via χPT and quark potential models.
          </p>
        </div>
        <div class="max-w-[280px] md:max-w-none mx-auto md:mx-0 w-full">
          <img src="/photo.png" alt="" class="w-full rounded-sm" />
          <div class="font-mono text-[10px] uppercase tracking-wider text-ink-3 mt-2 flex justify-between">
            <span>CHEP · PKU</span><span>Jul 2025 →</span>
          </div>
        </div>
      </div>

      <!-- by the numbers -->
      <div class="mt-7 grid grid-cols-2 md:grid-cols-4 border-t border-ink border-b border-rule">
        {[
          { v: totals.papers, l: 'Papers' },
          { v: totals.citations, l: 'Citations' },
          { v: totals.hIndex, l: 'h-index' },
          { v: totals.coauthors, l: 'Co-authors' },
        ].map((s, i) => (
          <div class:list={[
            "py-3.5 px-4",
            // Mobile (2 cols): right border on left cells (even idx); bottom border on top row
            i % 2 === 0 && "border-r border-rule",
            i < 2 && "border-b border-rule md:border-b-0",
            // Desktop (4 cols): right border between every cell except last
            "md:border-r md:border-rule",
            i === 3 && "md:border-r-0",
          ]}>
            <b class="block text-[28px] md:text-[32px] font-medium tracking-tight text-ink tabular-nums">{s.v}</b>
            <span class="block font-mono text-[10px] tracking-widest text-ink-3 uppercase mt-0.5">{s.l}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- § II · RECENT -->
  <section class="pt-10 md:pt-12 md:grid md:grid-cols-[90px_1fr] md:gap-6">
    <div class="font-mono text-[10px] tracking-[0.14em] uppercase text-ink-3 md:pt-1 mb-3 md:mb-0">
      <span class="text-mark mr-2 md:block md:mb-1 md:mr-0">§ II</span>RECENT
    </div>
    <div>
      <h2 class="text-[20px] md:text-[24px] font-medium tracking-tight mb-3">
        Five most recent papers
      </h2>
      <div>
        {recent.map((p) => <PaperRow paper={p} />)}
      </div>
    </div>
  </section>

  <!-- § III · THEMES -->
  <section class="pt-10 md:pt-12 md:grid md:grid-cols-[90px_1fr] md:gap-6">
    <div class="font-mono text-[10px] tracking-[0.14em] uppercase text-ink-3 md:pt-1 mb-3 md:mb-0">
      <span class="text-mark mr-2 md:block md:mb-1 md:mr-0">§ III</span>THEMES
    </div>
    <div>
      <h2 class="text-[20px] md:text-[24px] font-medium tracking-tight mb-3">Research themes</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-rule border border-rule">
        <ThemeCard
          title="Quark models"
          bodyTex={"Tetraquark bound states and resonances using constituent quark models, complex scaling, and diffusion Monte Carlo — including fully heavy $QQ\\bar{Q}\\bar{Q}$ states."}
          href="/research#quark_models"
        />
        <ThemeCard
          title="Hadronic interaction"
          bodyTex={"Coupled-channel dynamics for the $X(3872)$ pole structure, virtual states, and three-body molecular states like $DD^*\\bar{K}^*$."}
          href="/research#hadronic_interaction"
        />
        <ThemeCard
          title="Electromagnetic properties"
          bodyTex={"HBχPT calculations of polarizabilities for spin-$\\tfrac{1}{2}$ and spin-$\\tfrac{3}{2}$ singly heavy baryons and heavy triplet hadrons."}
          href="/research#electromagnetic_properties"
        />
        <ThemeCard
          title="Production and decays"
          bodyTex={"Branching fractions in $B^-\\to D^- X_{0,1}(2900)$ and hidden-charm strange molecular states in $B$ and $B_s$ decays."}
          href="/research#production_and_decays"
        />
      </div>
    </div>
  </section>
</Base>

<style>
  .pulse-dot {
    box-shadow: 0 0 0 0 rgba(176, 73, 42, 0.6);
    animation: pulse 2.4s infinite;
  }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(176,73,42,.6); }
    70% { box-shadow: 0 0 0 8px rgba(176,73,42,0); }
    100% { box-shadow: 0 0 0 0 rgba(176,73,42,0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .pulse-dot { animation: none; }
  }
</style>
