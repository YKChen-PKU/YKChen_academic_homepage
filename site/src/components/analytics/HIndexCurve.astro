---
import { bundle, hIndex } from '../../lib/data';
import { completeYears } from '../../lib/charts';

const data = completeYears(bundle.metrics.h_index_curve, 0);
const width = 600;
const height = 300;
const top = 20;
const bottom = 45;
const left = 38;
const right = 24;
const max = Math.max(hIndex + 2, 4);
const x = (index: number) => left + index * ((width - left - right) / Math.max(data.length - 1, 1));
const y = (value: number) => top + (height - top - bottom) * (1 - value / max);
let path = `M${x(0)},${y(data[0]?.value ?? 0)}`;
data.forEach(({ value }, index) => {
  if (index === 0) return;
  path += ` H${x(index)} V${y(value)}`;
});
---
<div class="chart-card reveal">
  <div class="chart-heading"><h2><span class="i18n-en">h-index trajectory</span><span class="i18n-zh">h 指数变化</span></h2><span><span class="i18n-en">current h = {hIndex}</span><span class="i18n-zh">当前 h = {hIndex}</span></span></div>
  <svg class="chart-svg" viewBox={`0 0 ${width} ${height}`} role="img" aria-label="Step chart showing h-index by year">
    {[0, Math.round(max / 2), max].map((tick) => (
      <g><line class="grid-line" x1={left} x2={width - right} y1={y(tick)} y2={y(tick)} /><text x={left - 10} y={y(tick) + 3} text-anchor="end">{tick}</text></g>
    ))}
    <path class="line-accent" d={path} />
    {data.map(({ year, value }, index) => <g>
      <title>{year}: h-index {value}</title>
      <circle cx={x(index)} cy={y(value)} r="4.5" fill="var(--chart-line)" />
      <text x={x(index)} y={height - 15} text-anchor="middle">{year}</text>
    </g>)}
  </svg>
</div>
