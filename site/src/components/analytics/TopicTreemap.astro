---
import { bundle } from '../../lib/data';

// Flatten the treemap one level: theme → paper (drop the arxiv-category layer
// since every paper here is hep-ph). Pre-compute the legend at build time.
type PaperLeaf = { name: string; value: number };
type ThemeNode = { name: string; children: PaperLeaf[] };

const themes: ThemeNode[] = [];
for (const themeNode of bundle.metrics.treemap.children ?? []) {
  const leaves: PaperLeaf[] = [];
  function walk(n: { name: string; value: number | null; children: any[] | null }): void {
    if (n.value != null && (!n.children || n.children.length === 0)) {
      leaves.push({ name: n.name, value: n.value });
    } else if (n.children) {
      for (const c of n.children) walk(c);
    }
  }
  walk(themeNode as any);
  if (leaves.length > 0) themes.push({ name: themeNode.name, children: leaves });
}

const themeColors: Record<string, string> = {
  spectrum_quark_models: '#1B2E5E',
  exotic_interactions: '#3B4F7E',
  em_chiPT: '#7787A8',
  production: '#B0492A',
  untagged: '#8C8579',
};

const data = JSON.stringify(themes);
const colorPayload = JSON.stringify(themeColors);
---
<figure class="border border-rule bg-paper p-4">
  <figcaption class="flex justify-between items-baseline mb-2">
    <span class="text-[14px] font-medium text-ink">Topic / keyword map</span>
    <span class="font-mono text-[10px] tracking-wider text-ink-3">
      theme → paper (cell area = 1 paper)
    </span>
  </figcaption>

  <!-- Legend -->
  <ul class="flex flex-wrap gap-x-4 gap-y-1 font-mono text-[10px] uppercase tracking-wider text-ink-2 mb-3">
    {themes.map((t) => (
      <li>
        <span
          class="inline-block w-3 h-3 align-middle mr-1.5"
          style={`background: ${themeColors[t.name] ?? '#8C8579'}`}
        ></span>
        {t.name.replace(/_/g, ' ')} <span class="text-ink-3">({t.children.length})</span>
      </li>
    ))}
  </ul>

  <div
    id="topic-treemap"
    class="w-full h-[360px] relative"
    data-themes={data}
    data-colors={colorPayload}
  ></div>
</figure>

<script>
  import * as d3 from 'd3';

  const root = document.getElementById('topic-treemap')!;
  const themes = JSON.parse(root.dataset.themes!) as {
    name: string;
    children: { name: string; value: number }[];
  }[];
  const colors = JSON.parse(root.dataset.colors!) as Record<string, string>;

  function render(): void {
    const w = root.clientWidth || 800;
    const h = root.clientHeight || 360;
    if (w === 0 || h === 0) return;

    // Clear previous render (if any)
    root.innerHTML = '';

    const data = { name: 'root', children: themes };
    const hierarchy = d3
      .hierarchy<any>(data)
      .sum((d: any) => d.value ?? 0)
      .sort((a, b) => (b.value ?? 0) - (a.value ?? 0));

    d3.treemap<any>().size([w, h]).paddingInner(2).paddingOuter(4).round(true)(hierarchy);

    const svg = d3
      .select(root)
      .append('svg')
      .attr('viewBox', `0 0 ${w} ${h}`)
      .attr('class', 'w-full h-full block');

    const leaf = svg
      .selectAll('g.leaf')
      .data(hierarchy.leaves())
      .enter()
      .append('g')
      .attr('class', 'leaf')
      .attr('transform', (d: any) => `translate(${d.x0},${d.y0})`);

    leaf
      .append('rect')
      .attr('width', (d: any) => Math.max(0, d.x1 - d.x0))
      .attr('height', (d: any) => Math.max(0, d.y1 - d.y0))
      .attr('fill', (d: any) => {
        const theme = d.parent?.data?.name as string | undefined;
        return colors[theme ?? ''] ?? '#8C8579';
      })
      .attr('stroke', '#F6F4EE')
      .attr('stroke-width', 1);

    leaf.append('title').text((d: any) => d.data.name);

    leaf
      .filter((d: any) => d.x1 - d.x0 > 70 && d.y1 - d.y0 > 28)
      .append('foreignObject')
      .attr('width', (d: any) => Math.max(0, d.x1 - d.x0 - 8))
      .attr('height', (d: any) => Math.max(0, d.y1 - d.y0 - 8))
      .attr('x', 4)
      .attr('y', 4)
      .append('xhtml:div')
      .attr(
        'style',
        'font-family: "IBM Plex Mono", monospace; font-size: 9px; color: #F6F4EE; line-height: 1.2; overflow: hidden;',
      )
      .text((d: any) => {
        const name = d.data.name as string;
        return name.length > 64 ? name.slice(0, 64) + '…' : name;
      });
  }

  render();
  // Re-render on resize (rAF-throttled).
  let raf: number | null = null;
  const ro = new ResizeObserver(() => {
    if (raf !== null) cancelAnimationFrame(raf);
    raf = requestAnimationFrame(render);
  });
  ro.observe(root);
</script>
