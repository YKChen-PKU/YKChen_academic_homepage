---
const path = Astro.url.pathname.replace(/\/$/, '');
const links = [
  { href: '/research', label: 'Research' },
  { href: '/publications', label: 'Publications' },
  { href: '/talks', label: 'Talks' },
  { href: '/analytics', label: 'Analytics' },
  { href: '/cv', label: 'CV' },
];
---
<nav aria-label="primary" class="flex items-baseline justify-between border-b border-rule pb-4">
  <a href="/" class="text-[15px] font-semibold tracking-tight text-ink hover:text-accent transition-colors">
    Yan-Ke Chen
    <span class="font-normal text-ink-3 text-[13px] ml-1">陈彦珂</span>
  </a>
  <ul class="flex gap-6 text-[12px] font-medium tracking-[0.08em] uppercase font-mono text-ink-2">
    {links.map((l) => (
      <li>
        <a
          href={l.href}
          class:list={[
            "hover:text-accent transition-colors",
            path === l.href && "text-accent",
          ]}
        >
          {l.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
