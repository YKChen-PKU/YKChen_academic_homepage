---
import T from './T.astro';
const path = Astro.url.pathname;
const links = [
  { href: '/research/', label: 'Research', labelZh: '研究方向' },
  { href: '/publications/', label: 'Publications', labelZh: '论文发表' },
  { href: '/analytics/', label: 'Analytics', labelZh: '数据分析' },
  { href: '/talks/', label: 'Talks', labelZh: '学术报告' },
];
---
<header class="site-header">
  <a href="/" class="brand" aria-label="Yan-Ke Chen, home">
    <svg class="brand-mark" viewBox="0 0 38 38" aria-hidden="true">
      <rect width="38" height="38" rx="9" fill="currentColor" />
      <circle cx="12" cy="13" r="3.2" fill="var(--accent)" />
      <circle cx="27" cy="11" r="2.2" fill="#f4f7ff" />
      <circle cx="24" cy="27" r="4" fill="var(--accent)" />
      <path d="M14.5 15.5 21 23M15 12.5l9.5-1" stroke="#f4f7ff" stroke-width="1.2" />
    </svg>
    <span class="brand-name">Yan-Ke Chen</span>
    <span class="brand-cn">陈炎柯</span>
  </a>
  <nav id="site-navigation" class="site-nav" aria-label="Primary navigation" data-open="false">
    <ul>
      {links.map((link, index) => (
        <li>
          <a href={link.href} class:list={[{ active: path.startsWith(link.href) }]} aria-current={path.startsWith(link.href) ? 'page' : undefined}>
            <span class="nav-index">0{index + 1}</span><T en={link.label} zh={link.labelZh} />
          </a>
        </li>
      ))}
      <li><a class="nav-cv" href="/cv/"><T en="CV" zh="简历" /> <span aria-hidden="true">↗</span></a></li>
    </ul>
  </nav>
  <div class="header-actions">
    <button class="language-toggle" type="button" aria-label="切换为中文" title="Switch language">
      <span class="language-toggle-track" aria-hidden="true">
        <span class="language-toggle-thumb"></span>
        <span class="language-option">EN</span><span class="language-option">中</span>
      </span>
    </button>
    <button class="theme-toggle" type="button" role="switch" aria-checked="false" aria-label="Dark mode" title="Switch color theme">
      <span class="theme-toggle-track" aria-hidden="true"><span class="theme-toggle-thumb">
        <svg class="sun-icon" viewBox="0 0 20 20"><circle cx="10" cy="10" r="3" /><path d="M10 1v2M10 17v2M1 10h2M17 10h2M3.6 3.6 5 5M15 15l1.4 1.4M16.4 3.6 15 5M5 15l-1.4 1.4" /></svg>
        <svg class="moon-icon" viewBox="0 0 20 20"><path d="M16.7 12.4A7 7 0 0 1 7.6 3.3 7 7 0 1 0 16.7 12.4Z" /></svg>
      </span></span>
    </button>
    <button class="menu-toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="site-navigation">
      <span data-en="Menu" data-zh="菜单">Menu</span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14" /></svg>
    </button>
  </div>
</header>
