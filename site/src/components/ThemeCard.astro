---
import { renderInlineMath } from '../lib/math';

interface Props {
  title: string;
  bodyTex: string;
  href: string;
}

const { title, bodyTex, href } = Astro.props;
---
<a
  href={href}
  class="block p-5 bg-paper border border-rule hover:bg-paper-2 transition-colors"
>
  <div class="text-[14px] font-medium text-ink mb-2">{title}</div>
  <p
    class="text-[13px] text-ink-2 leading-relaxed"
    set:html={renderInlineMath(bodyTex)}
  />
  <div class="mt-3 text-[11px] font-mono text-accent">→ Read more</div>
</a>
