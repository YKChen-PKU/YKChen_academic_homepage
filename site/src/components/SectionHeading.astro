---
import T from './T.astro';
interface Props {
  eyebrow: string;
  eyebrowZh: string;
  title: string;
  titleZh: string;
  id?: string;
  description?: string;
  descriptionZh?: string;
  href?: string;
  linkLabel?: string;
  linkLabelZh?: string;
}

const { eyebrow, eyebrowZh, title, titleZh, id, description, descriptionZh, href, linkLabel, linkLabelZh } = Astro.props;
---
<div class="section-heading reveal">
  <div>
    <p class="eyebrow"><T en={eyebrow} zh={eyebrowZh} /></p>
    <h2 id={id}><T en={title} zh={titleZh} /></h2>
    {description && <p class="section-description"><T en={description} zh={descriptionZh ?? description} /></p>}
  </div>
  {href && <a class="text-link" href={href}><T en={linkLabel ?? 'Explore'} zh={linkLabelZh ?? '查看'} /> <span aria-hidden="true">↗</span></a>}
</div>
