---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { bundle } from '../lib/data';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Yan-Ke Chen is a postdoctoral researcher at Peking University working on hadron spectroscopy, exotic hadrons, and low-energy hadron interactions.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Yan-Ke Chen',
  alternateName: '陈炎柯',
  url: 'https://yankechen.xyz',
  image: 'https://yankechen.xyz/photo.jpg',
  affiliation: { '@type': 'Organization', name: 'Center for High Energy Physics, Peking University' },
  sameAs: [
    'https://inspirehep.net/authors/2182746',
    `https://orcid.org/${bundle.author.orcid}`,
    'https://github.com/YKChen-PKU',
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#10254a" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        let saved = null;
        let language = null;
        try {
          saved = localStorage.getItem('yk-theme');
          language = localStorage.getItem('yk-lang');
        } catch {}
        const theme = saved === 'light' || saved === 'dark' ? saved : 'light';
        document.documentElement.dataset.theme = theme;
        document.documentElement.dataset.lang = language === 'zh' ? 'zh' : 'en';
        document.documentElement.lang = language === 'zh' ? 'zh-CN' : 'en';
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-shell">
      <Nav />
      <main id="main-content"><slot /></main>
      <Footer />
    </div>
    <script>
      const menuButton = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const navigation = document.querySelector<HTMLElement>('.site-nav');
      menuButton?.addEventListener('click', () => {
        const open = menuButton.getAttribute('aria-expanded') === 'true';
        menuButton.setAttribute('aria-expanded', String(!open));
        navigation?.setAttribute('data-open', String(!open));
      });
      navigation?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          menuButton?.setAttribute('aria-expanded', 'false');
          navigation.setAttribute('data-open', 'false');
        });
      });

      const root = document.documentElement;
      const themeToggles = document.querySelectorAll<HTMLButtonElement>('.theme-toggle');
      const languageToggles = document.querySelectorAll<HTMLButtonElement>('.language-toggle');
      const syncLanguage = (): void => {
        const chinese = root.dataset.lang === 'zh';
        root.lang = chinese ? 'zh-CN' : 'en';
        menuButton?.setAttribute('aria-label', chinese ? '菜单' : 'Menu');
        languageToggles.forEach((toggle) => {
          toggle.setAttribute('aria-label', chinese ? 'Switch to English' : '切换为中文');
          toggle.title = chinese ? 'Switch to English' : '切换为中文';
        });
        document.querySelectorAll<HTMLElement>('[data-en][data-zh]').forEach((element) => {
          element.textContent = chinese ? element.dataset.zh! : element.dataset.en!;
        });
        document.querySelectorAll<HTMLInputElement>('[data-placeholder-en][data-placeholder-zh]').forEach((input) => {
          input.placeholder = chinese ? input.dataset.placeholderZh! : input.dataset.placeholderEn!;
        });
        window.dispatchEvent(new Event('languagechange'));
      };
      const syncTheme = (): void => {
        const dark = root.dataset.theme === 'dark';
        const chinese = root.dataset.lang === 'zh';
        themeToggles.forEach((toggle) => {
          const label = chinese
            ? (dark ? '切换为浅色模式' : '切换为深色模式')
            : (dark ? 'Switch to light mode' : 'Switch to dark mode');
          toggle.setAttribute('aria-checked', String(dark));
          toggle.setAttribute('aria-label', label);
          toggle.title = label;
        });
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#081226' : '#10254a');
      };
      themeToggles.forEach((toggle) => {
        toggle.addEventListener('click', () => {
          const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try { localStorage.setItem('yk-theme', next); } catch {}
          syncTheme();
        });
      });
      languageToggles.forEach((toggle) => {
        toggle.addEventListener('click', () => {
          const next = root.dataset.lang === 'zh' ? 'en' : 'zh';
          root.dataset.lang = next;
          try { localStorage.setItem('yk-lang', next); } catch {}
          syncLanguage();
          syncTheme();
        });
      });
      syncLanguage();
      syncTheme();

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealItems = document.querySelectorAll<HTMLElement>('.reveal');
      if (!reduceMotion && 'IntersectionObserver' in window) {
        document.documentElement.classList.add('motion-ready');
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.06 });
        revealItems.forEach((item) => observer.observe(item));
      }
    </script>
  </body>
</html>
